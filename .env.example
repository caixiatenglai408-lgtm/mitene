# 管理画面
PORT=5050

# 「ブラウザで開く」で使うブラウザ（macOS のアプリ名。未設定時は --chrome 既定）
# MITENE_BROWSER_APP=Google Chrome
FLASK_SECRET_KEY=change-me-to-random-string

# 女の子パスワード暗号化（推奨）
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MITENE_SECRET_KEY=

# Vercel 永続化（Storage → KV をプロジェクトに接続すると自動設定）
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# REDIS_URL=  # Vercel Redis 連携時

# Vercel から送信する場合（Railway 等に worker/ をデプロイした URL）
# MITENE_WORKER_URL=https://your-worker.up.railway.app
# MITENE_WORKER_SECRET=ランダムな長い文字列

# 送信ワーカー側（Railway）でも同じ Redis / MITENE_SECRET_KEY を設定する

# CLI単体実行用（管理画面利用時は不要）
HIMEDECO_LOGIN_ID=
HIMEDECO_PASSWORD=
HIMEDECO_BASE_URL=
AUTH_STATE_PATH=playwright/.auth/himedeco.json
